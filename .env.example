# Convex
VITE_CONVEX_URL=

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Anthropic: the only AI provider (Claude via the native @anthropic-ai/sdk Messages API).
# Set in Convex env vars, NOT here. Get a key at https://console.anthropic.com/settings/keys
# npx convex env set ANTHROPIC_API_KEY <your-key>

# Portfolio variants (optional)
# If you keep several versions of your portfolio, one per role you apply for,
# describe them here and Calibre will suggest the version matching each job
# offer and print it as a link in the CV header. Leave empty to disable the
# feature entirely — nothing shows up in the UI.
# One line of JSON: [{"id","label","url","anonUrl"?,"keywords":[],"en"?:{"url","anonUrl"?,"label"?}}]
# `anonUrl` is used instead of `url` when the anonymize toggle is on.
# `en` is the English version, linked whenever the CV prints in English. Give it
# its own `label` when the default one is French, and its own `anonUrl` when the
# variant has one: without it, an anonymous English CV links the default anonUrl.
# VITE_PORTFOLIO_VARIANTS=[{"id":"design-system","label":"Portfolio : Design System","url":"https://example.com/portfolio/design-system","anonUrl":"https://example.com/cv/ab12","keywords":["design system","tokens","Figma"],"en":{"url":"https://example.com/portfolio/design-system?lang=EN","anonUrl":"https://example.com/cv/ab12-en","label":"Portfolio: Design System"}}]
