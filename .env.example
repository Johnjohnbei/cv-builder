# Convex
VITE_CONVEX_URL=

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Gemini — set in Convex env vars, NOT here
# npx convex env set GEMINI_API_KEY <your-key>

# Anthropic — Priority 2 fallback (Claude via native @anthropic-ai/sdk Messages API)
# Get key at https://console.anthropic.com/settings/keys
# npx convex env set ANTHROPIC_API_KEY <your-key>

# Portfolio variants (optional)
# If you keep several versions of your portfolio, one per role you apply for,
# describe them here and Calibre will suggest the version matching each job
# offer and print it as a link in the CV header. Leave empty to disable the
# feature entirely — nothing shows up in the UI.
# One line of JSON: [{"id","label","url","anonUrl"?,"keywords":[]}]
# `anonUrl` is used instead of `url` when the anonymize toggle is on.
# VITE_PORTFOLIO_VARIANTS=[{"id":"design-system","label":"Portfolio : Design System","url":"https://example.com/portfolio/design-system","anonUrl":"https://example.com/cv/ab12","keywords":["design system","tokens","Figma"]}]
